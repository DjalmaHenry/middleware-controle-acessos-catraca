{
  "name": "ponte-id",
  "version": "0.1.7",
  "description": "Integração local entre catracas Control iD e ActiveSoft SIGA",
  "main": "dist/main/main.js",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc && node scripts/copy-static.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "build:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./build-windows.ps1",
    "build:windows:macos": "bash ./build-windows-macos.sh",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "br.com.difinitylabs.ponteid",
    "productName": "Ponte ID",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "dist/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ponte ID",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
